# Paste this (with your real values) into Streamlit Cloud:
# your app → ⋮ → Settings → Secrets.  Never upload real keys to GitHub.

GEMINI_API_KEY = "paste-your-gemini-key-here"
GEMINI_MODEL = "gemini-2.5-flash"
# "on_open" = fresh data whenever someone opens the dashboard (default)
# "auto"    = also re-check every REFRESH_MINUTES while the page stays open
REFRESH_MODE = "on_open"
REFRESH_MINUTES = 5
TIMEZONE = "Asia/Kolkata"

# One line per data source: "Name shown in dashboard" = "link"
# Works with normal Google Sheets links (shared as "Anyone with the link – Viewer"),
# "Publish to web" CSV links, Google Drive CSV/Excel file links, or any direct CSV URL.
# Add #gid=... from the browser address bar to pick a specific tab.
[data_sources]
"Sales" = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit#gid=0"
# "Marketing" = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit#gid=123456789"

# Optional, for the X / Discord workspaces later:
# X_BEARER_TOKEN = ""
# DISCORD_BOT_TOKEN = ""
